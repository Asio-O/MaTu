<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="码图.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    Title="码图">

    <!--
        外壳只剩一条标题栏：窗口内容整体延伸到标题栏（ExtendsContentIntoTitleBar），
        标题条自己刷成跟页面一样的底色，不再有「系统标题栏 + 灰按钮行」那种割裂感。
        真正的工具条在页面里（wwwroot/index.html），这里只留「打开项目 / 重新分析」
        和一条状态副标题。
    -->
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!--
            标题栏底色由 App.xaml 的 ThemeDictionaries 提供，根元素一换 RequestedTheme，
            这一条（以及系统画的窗口按钮，见 ApplyTheme）就跟着换。
        -->
        <Border x:Name="TitleBand" Grid.Row="0"
                Background="{ThemeResource AppTitleBandBrush}"
                BorderBrush="{ThemeResource AppTitleBandBorderBrush}"
                BorderThickness="0,0,0,1">
            <controls:TitleBar x:Name="AppTitleBar" Title="码图" Subtitle="等待打开项目"
                               Background="Transparent">
                <controls:TitleBar.LeftHeader>
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,10,0">
                        <Button x:Name="OpenButton" Click="OnOpenClicked"
                                ToolTipService.ToolTip="选择要分析的 C# 项目目录">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8B7;" FontSize="13"/>
                                <TextBlock Text="打开项目" FontSize="12"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="ReloadButton" Click="OnReloadClicked"
                                ToolTipService.ToolTip="重新分析当前项目（改完源码保存后，图也会自动刷新）">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE72C;" FontSize="13"/>
                                <TextBlock Text="重新分析" FontSize="12"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </controls:TitleBar.LeftHeader>
            </controls:TitleBar>
        </Border>

        <WebView2 x:Name="WebView" Grid.Row="1"/>
    </Grid>
</Window>
