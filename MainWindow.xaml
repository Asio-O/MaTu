<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="码图.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="码图">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Padding="8" Spacing="8">
            <Button x:Name="OpenButton" Content="打开项目" Click="OnOpenClicked"/>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="Gray"/>
        </StackPanel>

        <WebView2 x:Name="WebView" Grid.Row="1"/>
    </Grid>
</Window>